[node name="RichTextLabel" type="RichTextLabel" parent="ColorRect/MarginContainer/HBoxContainer/HBoxContainer2/VBoxContainer2"]
layout_mode = 2
size_flags_vertical = 3
text = "   Lewy przycisk myszy do poruszania się, podnoszenia przedmiotów, używania ich i dialogów.
   Używanie przedmiotów tylko gdy jesteś blisko przeznaczonego miejsca (przy maszynie/Dieselu).
   Klikanie na okno dialogowe skipuje, a potem kończy dialog."
